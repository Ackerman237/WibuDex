# Server
PORT=3333

# doujin.desu.xxx API decryption keys (extract from site bundle via `npm run get-secret`)
DOUJIN_APP_SECRET=
DOUJIN_SALT=

# Optional: proxy for nekopoi.care when blocked (socks5://... or http://...)
NEKO_PROXY_URL=

# Optional: auto-disconnect VPN after this much inactivity from always-on
# targets (e.g. user left neko section). Reconnects automatically on next use.
VPN_IDLE_TIMEOUT_MS=180000

# Optional: pino log level (info, warn, error)
LOG_LEVEL=info

# Optional: path to Chrome/Chromium executable for puppeteer-core
PUPPETEER_EXECUTABLE_PATH=
