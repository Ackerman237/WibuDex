{
  "name": "doujin-scraper",
  "version": "1.0.0",
  "description": "Scraper untuk doujin.desu.xxx dan nekopoi.care",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.js",
    "test:cache": "vitest run tests/cache.test.js",
    "test:fetcher": "vitest run tests/fetcher.test.js",
    "test:security": "vitest run tests/security.test.js",
    "test:validator": "vitest run tests/validator.test.js",
    "get-secret": "node --env-file=.env scripts/get-secret.js",
    "icons": "node scripts/generate-icons.mjs",
    "demo": "node --env-file=.env scripts/demo.js",
    "demo:doujin": "node --env-file=.env scripts/demo.js --doujin-only",
    "demo:neko": "node --env-file=.env scripts/demo.js --neko-only",
    "demo:fast": "node --env-file=.env scripts/demo.js --skip-images"
  },
  "dependencies": {
    "express": "^4.22.2",
    "express-rate-limit": "7.5.0",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^9.1.0",
    "pino": "^10.3.1",
    "puppeteer-core": "^25.8.0",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.10.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
